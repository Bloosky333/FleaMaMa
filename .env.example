# Postgres connection string. In production use the Supabase "transaction pooler" URL (port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fleamama
# Random secret used to sign admin session cookies: `openssl rand -base64 32`
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: enables reading photos of the old FileMaker screens in the history import.
ANTHROPIC_API_KEY=
# Public address of the app, used in links sent by email (falls back to the request host).
APP_URL=http://localhost:3000
# Gmail account used to send emails (needs 2-Step Verification and an app password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Brocante
# For development: print emails instead of sending them.
# EMAIL_TRANSPORT=log
# Protects /api/outbox/process (called by the scheduled job).
CRON_SECRET=change-me-too
